# --- Obligatoire ---------------------------------------------------------------
# Base PostgreSQL (Railway fournit cette variable). Les tables sont créées au démarrage.
DATABASE_URL=postgresql://sabzi:sabzi@localhost:5432/sabzi
# Adresse publique du site, sans barre finale
NEXT_PUBLIC_SITE_URL=https://www.sabzi.tech
# Clé de signature des sessions du back-office : 32 caractères aléatoires minimum (openssl rand -hex 32)
AUTH_SECRET=
# Premier compte administrateur, créé au démarrage si aucun compte n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Facultatif ----------------------------------------------------------------
# true = affiche aussi les brouillons sur le site public. À laisser vide en production.
SHOW_DRAFTS=
# Dossier des images envoyées. Sur Railway : chemin d'un volume persistant (ex. /data/uploads)
MEDIA_DIR=
# Google Search Console (compte de service). GSC_SITE_URL : « sc-domain:sabzi.tech » ou « https://www.sabzi.tech/ »
GSC_SITE_URL=
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# PageSpeed Insights : le test de vitesse fonctionne sans clé, avec un quota réduit
PAGESPEED_API_KEY=
# Brevo : notification par e-mail à chaque nouveau contact
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CONTACT_NOTIFY_EMAIL=
